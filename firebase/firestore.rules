rules_version = '2';

// ============================================================================
// TRIBBU — RÈGLES DE SÉCURITÉ CLOUD FIRESTORE (firestore.rules)
// Architecture SaaS Multi-Associations (Isolation par grande_tribbu_id)
// Hiérarchie : Grande Tribbu (Association) > Tribbu (Commission) > Tippi > Feu de camp
// Rôles : MANITOU, CHEF, PYGMEE
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // FONCTIONS UTILITAIRES SÉCURISÉES (SANS ERREUR SUR PROFIL EN COURS DE CRÉATION)
    // ------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserId() {
      return request.auth.uid;
    }

    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Vérifie si l'utilisateur est le Grand Manitou d'une association spécifique
    function isManitouOfGrandeTribbu(gtId) {
      return isSignedIn() && (
        (hasProfile() && getUserProfile().global_role == 'MANITOU') ||
        (gtId != null &&
          exists(/databases/$(database)/documents/grande_tribbu/$(gtId)) &&
          get(/databases/$(database)/documents/grande_tribbu/$(gtId)).data.manitou_id == currentUserId())
      );
    }

    // Vérifie si l'utilisateur est membre actif d'une association (Grande Tribbu)
    function isMemberOfGrandeTribbu(gtId) {
      return isSignedIn() && (
        gtId == null ||
        isManitouOfGrandeTribbu(gtId) ||
        (hasProfile() &&
          getUserProfile().grande_tribbu_ids != null &&
          gtId in getUserProfile().grande_tribbu_ids)
      );
    }

    function isChefOfTribbu(gtId, tribbuId) {
      return isManitouOfGrandeTribbu(gtId) || (
        hasProfile() && (
          getUserProfile().global_role == 'CHEF' ||
          (getUserProfile().chef_tribbu_ids != null &&
            tribbuId in getUserProfile().chef_tribbu_ids)
        )
      );
    }

    function isAnyChefOrManitouOfGrandeTribbu(gtId) {
      return isManitouOfGrandeTribbu(gtId) || (
        hasProfile() && (
          getUserProfile().global_role == 'CHEF' ||
          (getUserProfile().chef_tribbu_ids != null &&
            getUserProfile().chef_tribbu_ids.size() > 0)
        )
      );
    }

    // ------------------------------------------------------------------------
    // RÈGLES PAR COLLECTION (COMPATIBLES REQUÊTES LIST & ONSNAPSHOT)
    // ------------------------------------------------------------------------

    // 1. PROFILES
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && currentUserId() == userId;
      allow delete: if false;
    }

    // 2. GRANDE_TRIBBU (Associations du SaaS)
    // Lecture publique pour résoudre le slug d'URL `/<slug>` sur la page initiale
    match /grande_tribbu/{gtId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.manitou_id == currentUserId();
      allow update, delete: if isManitouOfGrandeTribbu(gtId);
    }

    // 3. TRIBBUS
    match /tribbus/{tribbuId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isManitouOfGrandeTribbu(request.resource.data.grande_tribbu_id);
      allow update: if isSignedIn() && isChefOfTribbu(resource.data.grande_tribbu_id, tribbuId);
      allow delete: if isSignedIn() && isManitouOfGrandeTribbu(resource.data.grande_tribbu_id);
    }

    // 4. TIPPIS
    match /tippis/{tippiId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isChefOfTribbu(
        request.resource.data.grande_tribbu_id,
        request.resource.data.tribbu_id
      );
      allow update, delete: if isSignedIn() && isChefOfTribbu(
        resource.data.grande_tribbu_id,
        resource.data.tribbu_id
      );
    }

    // 5. FEUX_DE_CAMP
    match /feux_de_camp/{feuId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.created_by == currentUserId();
      allow update, delete: if isSignedIn() && (
        resource.data.created_by == currentUserId() ||
        isManitouOfGrandeTribbu(resource.data.grande_tribbu_id) ||
        (resource.data.tribbu_id != null &&
          isChefOfTribbu(resource.data.grande_tribbu_id, resource.data.tribbu_id))
      );
    }

    // 6. CANAUX
    match /canaux/{canalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAnyChefOrManitouOfGrandeTribbu(request.resource.data.grande_tribbu_id) ||
        request.resource.data.type == 'FEU_DE_CAMP'
      );
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && isManitouOfGrandeTribbu(resource.data.grande_tribbu_id);
    }

    // 7. MEMBRES_ROLES (Rôles & Invitations par token)
    match /membres_roles/{roleId} {
      allow read: if isSignedIn() || resource.data.status == 'INVITED';
      allow create: if isSignedIn() && (
        request.resource.data.user_id == currentUserId() ||
        isAnyChefOrManitouOfGrandeTribbu(request.resource.data.grande_tribbu_id)
      );
      allow update: if isSignedIn() && (
        resource.data.user_id == currentUserId() ||
        resource.data.status == 'INVITED' ||
        isAnyChefOrManitouOfGrandeTribbu(resource.data.grande_tribbu_id)
      );
      allow delete: if isSignedIn() && isAnyChefOrManitouOfGrandeTribbu(resource.data.grande_tribbu_id);
    }

    // 8. MESSAGES
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.author_id == currentUserId();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.author_id == currentUserId() ||
        isManitouOfGrandeTribbu(resource.data.grande_tribbu_id)
      );
    }

    // 9. EMARGEMENTS (Read receipts)
    match /emargements/{emargementId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.user_id == currentUserId();
    }

    // 10. CANAL_LECTURES
    match /canal_lectures/{lectureId} {
      allow read, write: if isSignedIn();
    }

    // 11. PRESENCE
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && currentUserId() == userId;
    }
  }
}
