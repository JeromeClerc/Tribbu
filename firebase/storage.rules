rules_version = '2';

// ============================================================================
// TRIBBU — RÈGLES DE SÉCURITÉ FIREBASE CLOUD STORAGE (storage.rules)
// Bucket dossier : chat-attachments/{canalId}/{userId}/{fileName}
// Formats autorisés : .png, .jpg, .jpeg, .pdf (Taille max : 10 Mo)
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /chat-attachments/{canalId}/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/png') ||
          request.resource.contentType.matches('image/jpeg') ||
          request.resource.contentType.matches('application/pdf')
        );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}

