# ==============================================================================
# CONFIGURATION GOOGLE FIREBASE — TRIBBU PWA
# Copiez ce fichier en ".env.local" et renseignez vos clés depuis la Console Firebase
# (Paramètres du projet > Général > Vos applications > Application Web)
# ==============================================================================

VITE_FIREBASE_API_KEY=AIzaSyVotreCleApiFirebase
VITE_FIREBASE_AUTH_DOMAIN=votre-projet-tribbu.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=votre-projet-tribbu
VITE_FIREBASE_STORAGE_BUCKET=votre-projet-tribbu.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optionnel : URL publique de déploiement Vercel (utilisée pour les liens d'invitation)
VITE_APP_URL=http://localhost:5173
