# ==============================================================================
# CONFIGURATION SUPABASE — TRIBBU PWA
# Copiez ce fichier en ".env.local" et renseignez vos clés depuis le Dashboard Supabase
# (Project Settings > API)
# ==============================================================================

VITE_SUPABASE_URL=https://votre-projet-id.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-publique-anon-key

# Optionnel : URL publique de déploiement Vercel (utilisée pour les liens d'invitation)
VITE_APP_URL=http://localhost:5173

